# Variables de entorno para el Copiloto Virtual de Hipermaxi
# Copia este archivo como .env y completa los valores

# ── REQUERIDO ──────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── OPCIONALES (tienen defaults) ───────────────
# Directorio de persistencia de ChromaDB
VECTOR_STORE_DIR=knowledge/vector_store

# Score mínimo de similitud para incluir un chunk (0.0 - 1.0)
RAG_SCORE_THRESHOLD=0.65

# Máximo de chunks a recuperar por query
RAG_TOP_K=5

# Habilitar endpoint /ingest (solo desarrollo)
DEV_MODE=false

# Orígenes CORS permitidos (separados por coma)
CORS_ORIGINS=*
